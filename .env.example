# ================================================================
# SpaceToStudy Backend — Environment Variables
# Copy to .env and fill in before running: make up
#
# WARNING:
# The values below are LOCAL DEVELOPMENT placeholders only.
# Never use them in shared, staging or production environments.
# Generate real secrets with: openssl rand -hex 32
# ================================================================

# --- Server ---
SERVER_PORT=3000
SERVER_URL=http://localhost:3000
CLIENT_URL=http://localhost:8090

# For Traefik mode, use:
# SERVER_URL=https://s2s-api.docker.localhost
# CLIENT_URL=https://s2s.docker.localhost

COOKIE_DOMAIN=localhost

# --- MongoDB ---
# Local (default — uses mongodb service in docker-compose):
MONGODB_URL=mongodb://mongodb:27017/spacetostudy
# External (comment out mongodb service and set your Atlas URL):
# MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/spacetostudy

# --- JWT Secrets (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=local-dev-only-replace-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=local-dev-only-replace-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_SECRET=local-dev-only-replace-reset-secret
JWT_RESET_EXPIRES_IN=1h
JWT_CONFIRM_SECRET=local-dev-only-replace-confirm-secret
JWT_CONFIRM_EXPIRES_IN=24h

# --- Gmail OAuth2 (email sending) ---
MAIL_USER=your@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground

# --- SuperAdmin seed (created on first start) ---
MAIL_FIRSTNAME=Admin
MAIL_LASTNAME=User
MAIL_PASS=local-dev-only-change-me

# --- Azure Blob Storage (file uploads) ---
STORAGE_ACCOUNT=
ACCESS_KEY=
AZURE_HOST=

# --- Country State City API ---
COUNTRY_STATE_CITY_API_KEY=
COUNTRY_STATE_CITY_API_BASE_URL=https://api.countrystatecity.in/v1
COUNTRY_STATE_CITY_API_TIMEOUT=5000
